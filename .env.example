# ============================================================
# 环境变量示例文件
# 使用方法:
#   1. 复制本文件为 .env:  cp .env.example .env
#   2. 填入真实值
#   3. 设置权限(防止其他用户读取):  chmod 600 .env
#   4. 脚本启动时会自动读取同目录下的 .env
# 注意: .env 内含敏感信息, 切勿提交到 Git 或上传到公开位置
# ============================================================

# 登录账号
CHECKIN_USER=your_username_here

# 登录密码
CHECKIN_PASS=your_password_here

# Server酱 SENDKEY (用于微信通知, 可选; 留空则跳过通知)
SENDKEY=
